{
  "name": "mysql",
  "action_description": "Connects to MySQL and executes a query",
  "plugin_description": "MySQL connector",
  "action_type": "mysql_query",
  "runtime": "python 3.12",
  "secrets": ["mysql_password", "mysql_host", "mysql_port"],
  "inputs": [{
      "name": "database",
      "label": "Database",
      "data_type": "string",
      "required": true,
      "script_alias": "database"
    },
    {
      "name": "query",
      "label": "Query",
      "data_type": "string",
      "required": true,
      "script_alias": "query"
    },
    {
      "name": "user",
      "label": "User",
      "data_type": "string",
      "required": true,
      "script_alias": "user"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "label": "Result",
      "data_type": "string",
      "required": true,
      "script_alias": "result"
    }
  ]
}
