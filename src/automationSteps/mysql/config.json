{
  "name": "Run Query",
  "action_description": "Connects to MySQL and executes a query",
  "plugin_description": "MySQL connector",
  "action_type": "mysql_query",
  "runtime": "python 3.12",
  "secrets": ["mysql_connection"],
  "inputs": [{
      "name": "database",
      "label": "Database",
      "data_type": "string",
      "required": true,
      "script_alias": "database"
    },
    {
      "name": "query",
      "label": "Query",
      "data_type": "string",
      "required": true,
      "script_alias": "query"
    },
    {
      "name": "return_single_value",
      "label": "Return Single Value",
      "data_type": "boolean",
      "required": true,
      "script_alias": "result_single_value",
      "default": true
    },
    {
      "name": "connection_secret_tag",
      "label": "Connection Secret Tag",
      "data_type": "string",
      "required": true,
      "script_alias": "connection_secret_tag"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "label": "Result",
      "data_type": "string",
      "required": true,
      "script_alias": "result"
    }
  ]
}
